<?xml version="1.0" encoding="UTF-8"?>

<webpage lastModified="$Date$" id="dozbib">
 <title xml:lang="de">Willkommen bei der Bibliographie der Max Weber Stiftung</title>
 <title xml:lang="en">Welcome to the bibliography of the Max Weber Foundation</title>

 <article class="card mb-3" xml:lang="de">
   <div class="card-body">
     <h3>Ein Service von perspectivia.net</h3>
      <p>
        Die MWS-Bibliographie ist das <strong>zentrale Publikationsverzeichnis</strong> der Institute und Außenstellen
        der Max Weber Stiftung (MWS). Sie sammelt die <strong>Veröffentlichungen</strong> der <strong>Wissenschaftlerinnen
        und Wissenschaftler der Max Weber Stiftung</strong>. Als Erweiterung der Publikationsplattform
        <a href="https://perspectivia.net/">perspectivia.net</a> werden hier jedoch <strong>keine Volltexte</strong>
        bereitgestellt.
      </p>
      <p>
        Seit Juni 2026 arbeiten wir kontinuierlich an den Inhalten. Da es sich um ein langfristiges Projekt im Aufbau
        handelt, ist das Verzeichnis <strong>noch unvollständig</strong>. Wir befüllen die Bibliographie stetig mit
        neuen Datensätzen und <strong>freuen uns über Ihre Mithilfe, wenn Sie uns Ergänzungen oder Korrekturen melden</strong>.

      </p>
      <h3>Sie gehören einem Institut oder einer Außenstelle der MWS an?</h3>
      <p>
        Helfen Sie uns bei der Vervollständigung!<br/>
        <a href="../newPublication.xed">Hier können Sie Ihre Publikation an die Bibliographie melden</a>
      </p>
   </div>
 </article>
  <article class="card mb-3" xml:lang="en">
    <div class="card-body">
      <h3>A service provided by perspectivia.net</h3>
      <p>
        The MWS Bibliography is the <strong>central publication directory</strong> for the institutes and branch offices
        of the Max Weber Foundation (MWS). It compiles the <strong>publications</strong> of researchers <strong>affiliated
        with the MWS</strong>. Unlike the <a href="https://perspectivia.net/">perspectivia.net</a> publication platform,
        <strong>full-text versions</strong> are not available here.
      </p>
      <p>
        We have been continuously working on the entries since June 2026. Since this is a long-term project, the directory
        is still under development and <strong>not yet complete</strong>. We are constantly adding new publications to the
        bibliography and <strong>would appreciate your assistance in reporting any additions or corrections</strong>.
      </p>
      <h3>Are you affiliated with an institute or branch office of the MWS?</h3>
      <p>
        Help us complete the bibliography!<br/>
        <a href="../newPublication.xed">Click here to report your publication to the bibliography.</a>
      </p>
    </div>
  </article>

  <article class="card mb-3">
    <div class="card-body">
      <xed:form xmlns:xed="http://www.mycore.de/xeditor" method="post" role="form">
        <div class="form-group form-inline mb-0">

          <xed:bind xpath="/query">
            <xed:bind xpath="@mask" default="index.xed" />
            <xed:bind xpath="@numPerPage" default="10" />
            <xed:bind xpath="conditions[@format='xml']/boolean[@operator='and']">
              <xed:bind xpath="condition[@field='all'][@operator='contains']/@value">
                <label for="input" class="mycore-form-label">
                  <xed:output i18n="ubo.search.simple" />
                </label>
                <input id="input" type="text" class="mycore-form-input form-control-sm mr-2" />
              </xed:bind>

              <!-- Standard users must only find confirmed publications, admins find all publications -->
              <xed:choose>
                <xed:when test="not(xed:call-java('org.mycore.ubo.AccessControl','currentUserIsAdmin'))">
                  <xed:bind xpath="condition[@field='status'][@operator='='][@value='confirmed']" />
                </xed:when>
                <xed:otherwise>
                  <xed:bind xpath="condition[@field='objectType'][@operator='='][@value='mods']" />
                </xed:otherwise>
              </xed:choose>

            </xed:bind>

            <xed:bind xpath="sortBy[field[@name='year'][@order='descending']]" />

          </xed:bind>

          <button class="btn btn-sm btn-primary" type="submit" xed:target="servlet" xed:href="MCRQLSearchServlet">
            <xed:output i18n="button.search" />
          </button>

        </div>
      </xed:form>
    </div>
  </article>

  <xinclude uri="xslStyle:response-newest:solr:q=status%3Aconfirmed+AND+year%3A2025&amp;rows=4&amp;sort=created+desc,year+desc&amp;facet=false&amp;fl=id,year" />

  <aside id="sidebar">
    <xinclude uri="xslStyle:response-sidebar-mini:solr:q=status%3Aconfirmed&amp;rows=0" />
    <xinclude uri="xslStyle:response-sidebar-admin:solr:q=*%3A*&amp;rows=0&amp;facet=true&amp;facet.field=status&amp;facet.mincount=0&amp;facet.range=created&amp;facet.range=modified&amp;facet.range.start=NOW/DAY-30DAY&amp;facet.range.end=NOW&amp;facet.range.gap=%2B1DAY" />
    <xinclude uri="xslStyle:response-sidebar-admin:solr:q=status%3Aimported+AND+importID%3A*&amp;rows=0&amp;facet=true&amp;facet.sort=index&amp;facet.limit=-1&amp;facet.field=importID" />

    <article class="card" xml:lang="de">
      <div class="card-body bg-alternative">
        <hgroup>
          <h3>Kontakt:</h3>
        </hgroup>
        <p>
          <a href="mailto:perspectivia@MaxWeberStiftung.de">
            <span>perspectivia<br/>@MaxWeberStiftung.de</span>
          </a>
        </p>
      </div>
    </article>
    <article class="card" xml:lang="en">
      <div class="card-body bg-alternative">
        <hgroup>
          <h3>Contact:</h3>
        </hgroup>
        <p>
          <a href="mailto:perspectivia@MaxWeberStiftung.de">
            <span>perspectivia<br/>@MaxWeberStiftung.de</span>
          </a>
        </p>
      </div>
    </article>
  </aside>

</webpage>
